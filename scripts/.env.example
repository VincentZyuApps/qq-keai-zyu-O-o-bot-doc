# ==========================================
# QQ Bot 菜单同步脚本环境配置示范
# 请复制本文件为 .env 并填入实际 SSH 凭据
# ==========================================

# 远程服务器地址与 SSH 端口（示范占位）
REMOTE_HOST=your-server-ip
REMOTE_PORT=22
REMOTE_USER=your_username

# 认证方式（推荐使用系统已配置的免密私钥，无需明文密码）
# 如需指定私钥路径可配置: C:/Users/YourName/.ssh/id_rsa 或 ~/.ssh/id_rsa
SSH_KEY_PATH=~/.ssh/id_rsa

# 远程菜单目录路径（示范路径）
REMOTE_MENU_DIR=/path/to/koishi/data/qq-markdown-button-v2

# 本地落盘目录
LOCAL_MENU_DIR=./menu
